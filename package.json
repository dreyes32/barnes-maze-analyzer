{
  "name": "barnes-maze-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Client-side Barnes maze analysis for behavioral neuroscience",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "outputs": "vite-node scripts/write-example-outputs.ts",
    "mcp": "tsx mcp/src/index.ts",
    "mcp:typecheck": "tsc -p mcp/tsconfig.json --pretty false",
    "mcp:test": "vitest run --config mcp/vitest.config.ts",
    "mcp:smoke": "tsx mcp/scripts/smoke.ts",
    "mcp:build": "npm run mcp:typecheck",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build && npm run mcp:typecheck && npm run mcp:test && npm run mcp:smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "dexie": "4.2.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "9.33.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.41.0",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
